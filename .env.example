# Copy this file to .env and fill in ONE key.  .env is git-ignored - never commit it.
# The .env file may be in this project folder OR one directory above it (both are checked,
# this folder first). Variables already set in your shell take precedence. Placeholder values
# below are ignored, so an unedited copy never hides a real key in ../.env.

# Option A (preferred): course-provided Portkey gateway -> https://api.portkey.ai/v1
PORTKEY_API_KEY=your-portkey-api-key-here
# PORTKEY_MODEL=gpt-5.6-luna            # default; gpt-6-luna also works through the course gateway

# Option B (fallback): direct OpenAI API, used when no PORTKEY_API_KEY is set
OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-5-mini               # default for direct OpenAI

# Optional: force one provider when both keys are set ("portkey" or "openai")
# AI_PROVIDER=portkey

# Optional: reasoning effort for reasoning models (default "low"; "none" to disable)
# OPENAI_REASONING_EFFORT=low

# Optional: USD per 1M tokens for the cost estimate. Built-in official OpenAI list prices exist for
# gpt-5.6-luna, gpt-6-luna and gpt-5-mini. Course Portkey billing may differ.
# PRICE_INPUT_PER_1M=0.20
# PRICE_CACHED_INPUT_PER_1M=0.02
# PRICE_OUTPUT_PER_1M=1.20

# Optional: custom OpenAI-compatible endpoint for Option B (leave unset normally)
# OPENAI_BASE_URL=

# Optional: where the SQLite database lives (default data/espresso.db)
# ESPRESSO_DB_PATH=
